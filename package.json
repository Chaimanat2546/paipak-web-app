{
  "name": "paipak-web-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "build:workers": "opennextjs-cloudflare build",
    "preview:workers": "opennextjs-cloudflare preview --local --ip 127.0.0.1 --port 8787",
    "preview": "npm run build:workers && npm run preview:workers",
    "test:runtime:prepare": "node tests/runtime/fixture.mjs install",
    "test:runtime": "node tests/runtime/http-smoke.mjs",
    "test:runtime:clean": "node tests/runtime/fixture.mjs remove"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.14",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "overrides": {
    "@node-minify/core": {
      "glob": "10.5.0"
    }
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "4.155.0"
  }
}
